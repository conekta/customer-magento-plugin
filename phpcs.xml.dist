<?xml version="1.0"?>
<ruleset name="Conekta_Payments">
    <description>PHP cross-version compatibility for the PHP range declared in composer.json.</description>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/.github/*</exclude-pattern>

    <arg name="extensions" value="php,phtml"/>
    <arg name="colors"/>
    <arg value="p"/>

    <!-- Keep in sync with the "php" constraint in composer.json. -->
    <config name="testVersion" value="8.2-8.5"/>
    <rule ref="PHPCompatibility"/>
</ruleset>
